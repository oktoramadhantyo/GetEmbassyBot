# Salin file ini menjadi .env lalu isi nilainya.
# Catatan: file .env TIDAK boleh di-commit ke git (sudah masuk .gitignore).

# ===== Bot Telegram =====
# Token bot dari @BotFather (WAJIB)
TELEGRAM_BOT_TOKEN=123456:AAE...GANTI_TOKEN_ASLI_KAMU

# ===== Server bot (lokal) =====
# Kalau bot.py dijalankan lokal di PC yang sama dengan browser Gladius,
# bagian RAILWAY_URL di bawah TIDAK dipakai apa-apa. Yang penting hanya
# TELEGRAM_BOT_TOKEN dan AGENT_SECRET.
# URL yang dipakai userscript ada di gladius-embassy.user.js (SERVER_BOT).

# URL publik bot di Railway (HANYA bila deploy di Railway).
# Wajib sama dengan SERVER_BOT di userscript.
RAILWAY_URL=https://getembassybot.up.railway.app

# Kata kunci rahasia antara bot server dan userscript.
# Nilai ini HARUS SAMA di .env ini dan di AGENT_SECRET pada userscript.
AGENT_SECRET=ganti_dengan_kata_kunci_acak

# Agent lokal (jalur lama) meminta antrian tiap N detik.
AGENT_INTERVAL_DETIK=10

# Jika antrian pending tidak diproses agent dalam N menit, bot mengedit pesan
# menjadi "Server Gladius tidak tersambung".
WAIT_ANNOUNCE_MENIT=3

# Port HTTP endpoint bot. Kosongkan saat lokal (default 8080).
# Railway menyuntikkan PORT sendiri. Harus sama dengan port di SERVER_BOT (userscript).
# PORT=8080

# ===== Browser / Selenium (dipakai AGENT LOKAL, jalur lama) =====
# Port Chrome remote debugging (jalankan Chrome dengan flag:
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="C:\chrome-debug"
# agar agent bisa attach ke sesi Chrome yang sudah login Gladius).
DEBUG_PORT=9222

# URL halaman embassy Web Gladius
GLADIUS_URL=https://gladius.telkom.co.id/radonline/newradonline

# Timeout tunggu hasil & Last Five Usage (detik)
WAIT_HASIL=30
WAIT_LFU=30

# ===== Dropdown domain (dipakai AGENT LOKAL) =====
# Domain yang dicoba berurutan sampai kolom "Paket Radius / Paket PCRF" berisi.
# Catatan: bot cek dulu dengan dropdown apa adanya; baru loop daftar ini.
DAFTAR_DOMAIN=apps.telkom,telkom.net,gold.telkom,telkom.b2b

# Kata kunci teks kolom paket pada tabel hasil (opsional; default "paket radius").
TEKS_KOLOM_PAKET=paket radius

# ===== Output =====
# Folder tempat screenshot hasil
SCREENSHOT_DIR=outputs
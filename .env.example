# Salin file ini menjadi .env lalu isi nilainya.
# Catatan: file .env TIDAK boleh di-commit ke git (sudah masuk .gitignore).

# ===== Bot Telegram =====
# Token bot dari @BotFather (WAJIB)
TELEGRAM_BOT_TOKEN=123456:AAE...GANTI_TOKEN_ASLI_KAMU

# ===== Browser / Selenium =====
# Port Chrome remote debugging (jalankan Chrome dengan flag:
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="C:\chrome-debug"
# agar bot bisa attach ke sesi Chrome yang sudah login Gladius).
#DEBUG_PORT=9222

# URL halaman embassy Web Gladius
#GLADIUS_URL=https://gladius.telkom.co.id/radonline/newradonline

# Timeout tunggu hasil & Last Five Usage (detik)
#WAIT_HASIL=30
#WAIT_LFU=30

# ===== Output =====
# Folder tempat screenshot hasil
#SCREENSHOT_DIR=outputs
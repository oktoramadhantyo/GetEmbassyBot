# Salin file ini menjadi .env lalu isi nilainya.
# Catatan: file .env TIDAK boleh di-commit ke git (sudah masuk .gitignore).

# ===== Bot Telegram =====
# Token bot dari @BotFather (WAJIB)
TELEGRAM_BOT_TOKEN=123456:AAE...GANTI_TOKEN_ASLI_KAMU

# ===== Server bot (lokal) =====
# Kalau bot.py dijalankan lokal di PC yang sama dengan browser Gladius,
# yang penting hanya TELEGRAM_BOT_TOKEN dan AGENT_SECRET.
# URL yang dipakai userscript ada di gladius-embassy.user.js (SERVER_BOT).

# Kata kunci rahasia antara bot server dan userscript.
# Nilai ini HARUS SAMA di .env ini dan di AGENT_SECRET pada userscript.
AGENT_SECRET=ganti_dengan_kata_kunci_acak

# Jika antrian pending tidak diproses dalam N menit, bot mengedit pesan
# menjadi "Server Gladius tidak tersambung".
WAIT_ANNOUNCE_MENIT=3

# Port HTTP endpoint bot. Kosongkan saat lokal (default 8080).
# Railway menyuntikkan PORT sendiri. Harus sama dengan port di SERVER_BOT (userscript).
# PORT=8080

# ===== Dropdown domain =====
# Domain yang dicoba berurutan sampai kolom "Paket Radius / Paket PCRF" berisi.
# Harus sama dengan DAFTAR_DOMAIN di userscript.
DAFTAR_DOMAIN=apps.telkom,telkom.net,gold.telkom,telkom.b2b